# Backend. Defaults to a local sqlite file so the app and tests boot without Postgres.
# For real data, point this at your Supabase project's Postgres
# (Supabase Dashboard → Project Settings → Database → Connection String).
DATABASE_URL=sqlite:///./opportunity_tracker.db

# API settings
APP_NAME=opportunity-api
APP_DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Auth — Supabase Auth issues JWTs; the backend only validates them.
# Values from Supabase Dashboard → Project Settings → API.
APP_SUPABASE_URL=https://your-project-ref.supabase.co
APP_SUPABASE_JWT_SECRET=your-jwt-secret
# Optional; only override if you changed the default JWT audience.
APP_SUPABASE_JWT_AUDIENCE=authenticated

# Ollama (services/ai)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1

# Shared hosted Supabase development. See supabase/README.md for credentials/setup.
# Server-only SQLAlchemy psycopg URL from dashboard Connect (URL-encode password).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@db.fnldapsomswemayxhayk.supabase.co:5432/postgres?sslmode=require
APP_NAME=opportunity-api
APP_DEBUG=false
CORS_ORIGINS=http://localhost:3000
APP_SUPABASE_URL=https://fnldapsomswemayxhayk.supabase.co
# Optional legacy HS256 only. Leave empty for this project: ES256 uses public JWKS.
APP_SUPABASE_JWT_SECRET=
APP_SUPABASE_JWT_AUDIENCE=authenticated

# Browser-safe web configuration (publishable or legacy anon key only).
NEXT_PUBLIC_SUPABASE_URL=https://fnldapsomswemayxhayk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional privileged ingestion key: server-only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI services
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1
